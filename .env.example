# Salin menjadi .env lalu isi. Jangan commit .env.
PORT=3000

# Postgres dari docker-compose (port host 5433 agar tidak bentrok dengan Postgres lokal di 5432)
DATABASE_URL="postgresql://tes:tes@localhost:5433/tes_dev?schema=public"

# Ganti dengan string acak panjang yang berbeda untuk tiap secret (mis. `openssl rand -base64 48`)
JWT_ACCESS_SECRET="ganti-dengan-secret-acak-panjang-1"
JWT_REFRESH_SECRET="ganti-dengan-secret-acak-panjang-2"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Origin admin web yang diizinkan CORS (pisahkan dengan koma)
CORS_ORIGINS="http://localhost:5173"

# Isi 1 bila API ada di belakang proxy (Railway) agar rate limit membaca IP klien yang benar
TRUST_PROXY=0
# Level log: fatal|error|warn|info|debug|trace|silent. Default: debug (dev), info (production)
# LOG_LEVEL=info

# Opsional: true/false. Default: aktif kecuali NODE_ENV=production
# SWAGGER_ENABLED=true
